# Copy to .env.local for development or configure these in the deployment platform.
PORT=3000
HOSTNAME=0.0.0.0
# Enable only behind a proxy that overwrites forwarded IP headers.
TRUST_PROXY=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# REQUIRED for the first production startup (12+ character password).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional persistent mount paths. UPLOAD_DIR is linked to public/uploads by scripts/start.js.
# DATA_DIR=/data/db
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_STORAGE_BYTES=1073741824

# Public destinations used by header/footer/platform badges.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/8heshtaam
NEXT_PUBLIC_CASTBOX_URL=https://castbox.fm/
NEXT_PUBLIC_APPLE_PODCASTS_URL=https://podcasts.apple.com/
